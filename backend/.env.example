# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (Docker container from docker-compose.yml)
# Docker MongoDB is published on host port 27018 (27017 may be used by a local MongoDB install).
MONGO_URI=mongodb://admin:admin123@127.0.0.1:27018/?authSource=admin
MONGO_DB_NAME=mithaimart

# Variants with this much stock or less are marked "low stock" in the admin pages
LOW_STOCK_THRESHOLD=5

# Cloudinary (product image uploads). Get these from your Cloudinary dashboard.
# Keep the secret private: never commit the real .env file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
